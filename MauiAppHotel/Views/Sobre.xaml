<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppHotel.Views.Sobre"
    Title="Sobre">

    <VerticalStackLayout
        Padding="30"
        Spacing="20"
        VerticalOptions="Center">

        <Label
            Text="SOBRE O APP HOTEL"
            FontSize="26"
            FontAttributes="Bold"
            HorizontalOptions="Center"
            TextColor="DarkBlue"/>

        <Label
            Text="Aplicativo desenvolvido para facilitar a contratação de hospedagens."
            FontSize="17"
            HorizontalTextAlignment="Center"/>

        <Label
            Text="Desenvolvedora: Evellyn Moraes Melo"
            FontSize="16"
            HorizontalTextAlignment="Center"/>

        <Label
            Text="Ano de desenvolvimento: 2026"
            FontSize="16"
            HorizontalTextAlignment="Center"/>

    </VerticalStackLayout>
</ContentPage>